# which holds small static assets the app fetches at runtime and which must ship.
/data/
export/
_archive/

# TypeScript
*.tsbuildinfo

# Python
__pycache__/
*.pyc
precomputed_data.tar.gz

# Browser automation scratch output (snapshots, console logs, screenshots)
.playwright-mcp/

# Performance test reports
perf/reports/*.json
perf/reports/*.html
!perf/reports/.gitkeep
.lighthouseci/
